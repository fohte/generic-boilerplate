#!/usr/bin/env bash
# Find lines that a unified diff removes from template-managed files but that
# the template never owned, i.e. repo-specific content that a template update
# silently dropped.
#
# A removed line is reported when all of the following hold:
#   - its file exists in the rendering of the *old* template version
#   - the line does not appear in that rendering, ignoring version numbers,
#     commit SHAs and a trailing comma (so the repo added or edited it)
#   - the line is not added back anywhere in the same diff (moves and
#     conflict markers that keep the old side are not losses)
#
# Usage: gh pr diff <number> | scripts/find-lost-lines <old-render-dir>
#
# Output: one "<path><TAB><line>" per lost line (line is whitespace-trimmed).
# Exit status: 0 when nothing was lost, 1 otherwise.

set -euo pipefail

if [[ $# -ne 1 || ! -d "$1" ]]; then
  echo "Usage: $0 <old-render-dir> < diff" >&2
  exit 2
fi

lost=$(
  awk -v dir="$1" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    # Repos bump versions ahead of the template, so a template-owned line often
    # differs from the old render only by version. Masking versions keeps that
    # from reading as dropped repo-specific content, at the cost that a repo pin
    # on a template-managed key is overwritten without a report.
    function normalize(s) {
      gsub(sha, "<sha>", s)
      # Three or more parts: decimals ("0.5rem") and plain numbers
      # ("timeout-minutes: 30") are customizations, not versions.
      gsub(/[0-9]+\.[0-9]+(\.[0-9]+)+/, "<version>", s)
      # A JSON trailing comma depends on whether the repo has elements after
      # the line, not on its content, so the same line can differ by it alone.
      sub(/,$/, "", s)
      return s
    }
    # Listed positively (not "no alphanumerics") because awk classes such as
    # [[:alnum:]] do not match non-ASCII text on every awk, which would drop
    # Japanese-only lines as if they were "}".
    function generic(s) { return s ~ /^[][{}()<>,;:.\/|\\*_=~`#+"!?@$%^&-]*$/ }

    # Built by repetition because {40} is not supported by every awk.
    BEGIN { for (i = 0; i < 40; i++) sha = sha "[0-9a-f]" }

    /^diff --git / {
      path = $0
      sub(/^diff --git a\//, "", path)
      sub(/ b\/.*$/, "", path)
      in_hunk = 0
      next
    }
    # Only hunk bodies carry content; this keeps "--- a/x" / "+++ b/x" headers
    # from being mistaken for a removed / added line.
    /^@@/ { in_hunk = 1; next }
    !in_hunk { next }
    /^\+/ { added[trim(substr($0, 2))] = 1; next }
    /^-/ { n++; removed_path[n] = path; removed_line[n] = trim(substr($0, 2)) }

    END {
      for (i = 1; i <= n; i++) {
        p = removed_path[i]
        l = removed_line[i]
        # .copier-answers.yml is rewritten by copier itself. Punctuation-only
        # lines ("}", "---", blanks) are too generic to mean anything.
        if (p == ".copier-answers.yml" || generic(l) || (l in added)) continue

        if (!(p in loaded)) {
          loaded[p] = 1
          f = dir "/" p
          r = (getline x < f)
          if (r >= 0) managed[p] = 1
          while (r > 0) {
            owned[p SUBSEP normalize(trim(x))] = 1
            r = (getline x < f)
          }
          close(f)
        }
        # Files the template did not render are never touched by copier, so a
        # removal there (e.g. a lockfile regenerated by the workflow) is not ours to judge.
        if (!(p in managed) || ((p SUBSEP normalize(l)) in owned)) continue
        print p "\t" l
      }
    }
  '
)

[[ -z "$lost" ]] && exit 0
printf '%s\n' "$lost"
exit 1
