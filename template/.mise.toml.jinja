[tools]
lefthook = "2.1.14"
{%- if has_rust %}
"github:ast-grep/ast-grep" = "0.45.3"
{%- endif %}

# lefthook hooks
actionlint = "1.7.12"
"github:betterleaks/betterleaks" = "1.8.1"
node = "24.21.0"
pinact = "4.1.1"
"github:fohte/basefmt" = "0.1.0"
{% if not (type == 'node' or is_workspace) -%}
{#- Without a root package.json, prettier and commitlint must be hosted by mise. -#}
"npm:@commitlint/cli" = "21.2.3"
"npm:prettier" = "3.9.9"
{% endif -%}
shellcheck = "0.11.0"
shfmt = "3.14.1"

{%- if has_rust or has_db %}

[env]
{%- if has_db %}
{%- if db_pkgs | length == 1 %}
DATABASE_URL = "{% raw %}{{ exec(command=config_root ~ '/scripts/db-url {% endraw %}{{ db_pkgs[0].name }}{% raw %} dev') }}{% endraw %}"
TEST_DATABASE_URL = "{% raw %}{{ exec(command=config_root ~ '/scripts/db-url {% endraw %}{{ db_pkgs[0].name }}{% raw %} test') }}{% endraw %}"
{%- endif %}
_.file = ['.env', '.env.local']
{%- endif %}
{%- if has_rust %}
# Share target dir across worktrees to avoid full recompilation
CARGO_TARGET_DIR = "{% raw %}{{config_root}}{% endraw %}/target"
{%- endif %}
{%- endif %}
{%- if has_db %}

[tasks."db:up"]
description = "Start the local PostgreSQL databases"
file = "scripts/db-up"
{%- endif %}
