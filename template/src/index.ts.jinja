{#- This file is also `{% include %}`d verbatim from the subpackage index.ts
    template, where `pkg` is defined and `type`/`is_web_app`/`error_tracking`
    still refer to the root project's answers. Check `pkg` first so a
    subpackage render keys off its own `web_app`/`error_tracking` flags
    instead of the root's.

    The Node observability gate must stay in sync with the subpackage
    bootstrap.ts filename, `pkg_has_error_tracking` in package.json,
    error_tracking_pkgs in copier.yml, and the protobufjs allowBuilds gate.
    Browser-only SPAs do not use the Node bootstrap. -#}
{%- set pkg_has_node_observability = (pkg is defined and (pkg.web_app | default(false) or pkg.error_tracking | default(false)) and (pkg.tests | default(true)) and (not (pkg.spa | default(false)) or pkg.web_app | default(false))) -%}
{%- set is_bootstrap_wired = (pkg is defined and pkg_has_node_observability) or (pkg is not defined and type == 'node' and (is_web_app | default(false) or error_tracking | default(false))) -%}
{%- if is_bootstrap_wired -%}
import '#bootstrap'

{% endif -%}
import { err, ok, type Result } from 'neverthrow'

export const greet = (name: string): Result<string, Error> => {
  if (!name) return err(new Error('name must not be empty'))
  return ok(`Hello, ${name}!`)
}
