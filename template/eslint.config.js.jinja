import { config } from '@fohte/eslint-config'
{%- if has_spa_pkg and is_workspace %}
import storybook from 'eslint-plugin-storybook'
{%- endif %}

{% if has_spa_pkg and is_workspace -%}
{#- @fohte/eslint-config's `tailwind` option takes a single cssConfigPath, so
    only the first spa subpackage is wired up here. No downstream consumer of
    this template currently needs more than one spa subpackage per
    workspace. -#}
export default config(
  {
    typescript: { typeChecked: true },
    errorHandling: {},
    tailwind: { cssConfigPath: '{{ spa_pkgs[0].name }}/src/index.css' },
  },
  ...storybook.configs['flat/recommended'],
  {
    files: [
      '{{ spa_pkgs[0].name }}/.storybook/**/*.ts',
      '{{ spa_pkgs[0].name }}/vite.config.ts',
      '{{ spa_pkgs[0].name }}/vitest.config.ts',
    ],
    rules: { 'no-restricted-imports': 'off' },
  },
)
{%- else -%}
export default config({
  typescript: { typeChecked: true },
  errorHandling: {},
})
{%- endif %}
