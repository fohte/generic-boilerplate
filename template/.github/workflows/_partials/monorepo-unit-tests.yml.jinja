{%- if is_workspace %}
{% raw %}
  # Build the unit-test matrix at runtime: branch protection pins the fixed-name
  # `unit-test` gate below, so the per-package legs are enumerated here instead.
  setup:
    runs-on: ubuntu-slim
    outputs:
      packages: ${{ steps.set-packages.outputs.packages }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 2

      - name: Detect changed files
        uses: tj-actions/changed-files@9426d40962ed5378910ee2e21d5f8c6fcbf2dd96 # v47.0.6
        id: changed
        with:
          json: true
          # Emit valid JSON; the default escapes quotes and breaks jq parsing.
          escape_json: false

      - name: Build package matrix
        id: set-packages
        env:
          # Changes to these files affect every package, so they trigger the full matrix.
          GLOBAL_PATHS_REGEX: '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|\.github/workflows/test\.yml)$'
          CHANGED_FILES: ${{ steps.changed.outputs.all_modified_files }}
        run: |
          # Workspace packages are the directories holding a non-root package.json
          # that declares a `test` script. Packages without one (e.g. node
          # subpackages opted out with `tests: false`) would otherwise be picked
          # up here and then crash `pnpm run test` in unit-test-run.
          mapfile -t all_pkgs < <(git ls-files '*/package.json' | grep -v node_modules | sed 's#/package.json$##' | sort -u)
          pkgs=()
          for dir in "${all_pkgs[@]}"; do
            if jq -e '.scripts.test' "${dir}/package.json" >/dev/null 2>&1; then
              pkgs+=("${dir}")
            fi
          done

          if echo "$CHANGED_FILES" | jq -r '.[]' | grep -qE "$GLOBAL_PATHS_REGEX"; then
            selected=("${pkgs[@]}")
          else
            selected=()
            for dir in "${pkgs[@]}"; do
              if echo "$CHANGED_FILES" | jq -e --arg d "${dir}/" 'any(.[]; startswith($d))' >/dev/null; then
                selected+=("$dir")
              fi
            done
          fi

          if [ ${#selected[@]} -eq 0 ]; then
            packages='[]'
          else
            packages=$(printf '%s\n' "${selected[@]}" | jq -R . | jq -sc .)
          fi
          echo "packages=$packages" >> "$GITHUB_OUTPUT"
          echo "Selected packages: $packages"

  unit-test-run:
    needs: setup
    if: ${{ needs.setup.outputs.packages != '[]' }}
    strategy:
      fail-fast: false
      matrix:
        package: ${{ fromJSON(needs.setup.outputs.packages) }}
    name: 'unit-test (${{ matrix.package }})'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          version: 2026.9.14

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            ${{ steps.pnpm-store.outputs.path }}
          key: ${{ runner.os }}-pnpm-store-${{ hashFiles('pnpm-lock.yaml') }}
          restore-keys: ${{ runner.os }}-pnpm-store-

      # Install only the matrix package and its workspace dependencies, not the
      # whole workspace, so each parallel leg skips unrelated packages' installs.
      - run: pnpm install --filter ./${{ matrix.package }}... --frozen-lockfile
{%- endraw -%}
{%- if has_spa_pkg -%}
{% raw %}

      # Story tests run through @storybook/addon-vitest's browser project, which
      # needs a devDependency on `playwright` — only spa packages declare one.
      - name: Check if this package needs Playwright
        id: needs-playwright
        run: |
          if jq -e '.devDependencies.playwright' "${{ matrix.package }}/package.json" >/dev/null 2>&1; then
            echo "needed=true" >> "$GITHUB_OUTPUT"
          else
            echo "needed=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Get Playwright version
        id: playwright-version
        if: steps.needs-playwright.outputs.needed == 'true'
        working-directory: ${{ matrix.package }}
        run: echo "version=$(pnpm exec playwright --version | cut -d' ' -f2)" >> "$GITHUB_OUTPUT"

      - name: Cache Playwright browsers
        id: playwright-cache
        if: steps.needs-playwright.outputs.needed == 'true'
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: ${{ runner.os }}-playwright-${{ steps.playwright-version.outputs.version }}

      - name: Install Playwright chromium
        if: steps.needs-playwright.outputs.needed == 'true' && steps.playwright-cache.outputs.cache-hit != 'true'
        working-directory: ${{ matrix.package }}
        run: pnpm exec playwright install --with-deps chromium

      - name: Install Playwright system dependencies
        if: steps.needs-playwright.outputs.needed == 'true' && steps.playwright-cache.outputs.cache-hit == 'true'
        working-directory: ${{ matrix.package }}
        run: pnpm exec playwright install-deps chromium
{%- endraw -%}
{%- endif -%}
{% raw %}

      - name: Run tests
        working-directory: ${{ matrix.package }}
        run: pnpm run test

  # Fixed name for branch protection: matrix leg names are dynamic, and knip
  # has no `needs`, so this gate (skip == success) stands in for both.
  unit-test:
    runs-on: ubuntu-slim
    needs:
      - setup
      - unit-test-run
      - knip
    if: failure()
    steps:
      - run: exit 1
{%- endraw %}
{%- else %}

  detect-changes:
    runs-on: ubuntu-slim
    outputs:
{%- for pkg in testable_subpackages %}
      {{ pkg.name }}: {% raw %}${{ steps.changes-{% endraw %}{{ pkg.name }}{% raw %}.outputs.any_modified }}{% endraw %}
{%- endfor %}
      workflow: {% raw %}${{ steps.changes-workflow.outputs.any_modified }}{% endraw %}
{%- if is_workspace %}
      root-lockfile: {% raw %}${{ steps.changes-root-lockfile.outputs.any_modified }}{% endraw %}
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 2
{%- for pkg in testable_subpackages %}

      - name: Check for {{ pkg.name }} changes
        uses: tj-actions/changed-files@9426d40962ed5378910ee2e21d5f8c6fcbf2dd96 # v47.0.6
        id: changes-{{ pkg.name }}
        with:
          files: {{ pkg.name }}/**
{%- endfor %}

      - name: Check for workflow changes
        uses: tj-actions/changed-files@9426d40962ed5378910ee2e21d5f8c6fcbf2dd96 # v47.0.6
        id: changes-workflow
        with:
          files: .github/workflows/test.yml
{%- if is_workspace %}

      - name: Check for root lockfile changes
        uses: tj-actions/changed-files@9426d40962ed5378910ee2e21d5f8c6fcbf2dd96 # v47.0.6
        id: changes-root-lockfile
        with:
          files: |
            package.json
            pnpm-lock.yaml
            pnpm-workspace.yaml
{%- endif %}
{%- for pkg in testable_subpackages %}

  unit-test-{{ pkg.name }}:
    needs: detect-changes
{%- if pkg.type == 'node' and is_workspace %}
    if: >-
      needs.detect-changes.outputs.{{ pkg.name }} == 'true' ||
      needs.detect-changes.outputs.workflow == 'true' ||
      needs.detect-changes.outputs.root-lockfile == 'true'
{%- else %}
    if: >-
      needs.detect-changes.outputs.{{ pkg.name }} == 'true' ||
      needs.detect-changes.outputs.workflow == 'true'
{%- endif %}
    runs-on: ubuntu-latest
{%- if pkg.type == 'rust' %}
    env:
      SCCACHE_GHA_ENABLED: 'true'
      RUSTC_WRAPPER: 'sccache'
{%- endif %}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
{%- if pkg.type == 'go' %}

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: {{ pkg.name }}/go.mod
          cache-dependency-path: {{ pkg.name }}/go.sum
{%- endif %}
{%- if pkg.type == 'rust' %}

      - run: rustup show

      # Run sccache-action before mise-action so that sccache binary is
      # available when mise installs cargo tools (RUSTC_WRAPPER=sccache).
      - name: Run sccache-cache
        uses: mozilla-actions/sccache-action@fc920bf0ec8de6ee65d409111f7ec508035751ba # v0.0.11
{%- endif %}

      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          version: 2026.9.14{{ '\n          install_args: lefthook' if pkg.type == 'go' else '' }}
{%- if pkg.type == 'node' %}
{%- if is_workspace %}
{#- Workspace mode: install from root (pnpm only) #}

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles('pnpm-lock.yaml') }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}

      - run: pnpm install --frozen-lockfile

      - name: Run tests
        working-directory: {{ pkg.name }}
        run: pnpm run test
{%- else %}
{#- Non-workspace mode: per-package install #}

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles({% endraw %}'{{ pkg.name }}/pnpm-lock.yaml'{% raw %}) }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}

      - run: cd "{{ pkg.name }}" && pnpm install --frozen-lockfile
{%- if pkg.spa | default(false) %}

      - name: Get Playwright version
        id: playwright-version
        working-directory: {{ pkg.name }}
        run: echo "version=$(pnpm exec playwright --version | cut -d' ' -f2)" >> "$GITHUB_OUTPUT"

      - name: Cache Playwright browsers
        id: playwright-cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/ms-playwright
          key: {% raw %}${{ runner.os }}-playwright-${{ steps.playwright-version.outputs.version }}{% endraw %}

      - name: Install Playwright chromium
        if: steps.playwright-cache.outputs.cache-hit != 'true'
        working-directory: {{ pkg.name }}
        run: pnpm exec playwright install --with-deps chromium

      - name: Install Playwright system dependencies
        if: steps.playwright-cache.outputs.cache-hit == 'true'
        working-directory: {{ pkg.name }}
        run: pnpm exec playwright install-deps chromium
{%- endif %}

      - name: Run tests
        working-directory: {{ pkg.name }}
        run: pnpm run test
{%- endif %}
{%- elif pkg.type == 'rust' %}
{%- if use_coverage %}

      - name: Install cargo-llvm-cov
        uses: taiki-e/install-action@9983c65e42da123ff25d1f78505eb6de315aa172 # v2.87.20
        with:
          tool: cargo-llvm-cov

      - name: Install llvm-tools-preview
        run: rustup component add llvm-tools-preview

      - name: Run tests with coverage
        working-directory: {{ pkg.name }}
        run: cargo llvm-cov --lcov --output-path lcov.info

      - name: Upload coverage to Codecov
        uses: codecov/codecov-action@fb8b3582c8e4def4969c97caa2f19720cb33a72f # v7.0.0
        with:
          token: {% raw %}${{ secrets.CODECOV_TOKEN }}{% endraw %}
          files: {{ pkg.name }}/lcov.info
          flags: {{ pkg.name }}
          fail_ci_if_error: false
{%- else %}

      - name: Run tests
        working-directory: {{ pkg.name }}
        run: cargo test
{%- endif %}
{%- elif pkg.type == 'go' %}

      - name: Run Go format and vet checks through lefthook
        run: |
          lefthook run pre-commit --all-files \
            --command {{ 'go-fmt-' ~ pkg.name if has_multiple_go_pkgs else 'go-fmt' }} \
            --command {{ 'go-vet-' ~ pkg.name if has_multiple_go_pkgs else 'go-vet' }}

      - name: Run Go tests
        working-directory: {{ pkg.name }}
        run: go test ./...
{%- endif %}
{%- endfor %}

  # Fixed name for branch protection: per-package job names are dynamic, and
  # knip (when generated) has no `needs`, so this gate (skip == success)
  # stands in for both.
  unit-test:
    runs-on: ubuntu-slim
    needs:
      - detect-changes
{%- for pkg in testable_subpackages %}
      - unit-test-{{ pkg.name }}
{%- endfor %}
{%- if testable_node_pkgs %}
      - knip
{%- endif %}
    if: failure()
    steps:
      - run: exit 1
{%- endif %}
{#- Jinja edge trimming prevents blank lines at the include boundary. -#}
