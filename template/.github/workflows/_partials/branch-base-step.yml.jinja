      # Without a base, changed-files compares a new branch against HEAD^ only,
      # so changes from its earlier commits go undetected.
      - name: Find where this branch left the default branch
        id: branch-base
        if: github.ref_name != github.event.repository.default_branch
        env:
          DEFAULT_BRANCH: {% raw %}${{ github.event.repository.default_branch }}{% endraw %}
        run: |
          sha=$(git merge-base "origin/$DEFAULT_BRANCH" HEAD)
          echo "sha=$sha" >> "$GITHUB_OUTPUT"
{#- Jinja edge trimming prevents blank lines at the include boundary. -#}
