{#- Subpackages that get a unit-test job: all Go and rust subpackages, plus node
    subpackages unless they opt out with `tests: false`. Built once here so
    detect-changes outputs / change-detection steps / unit-test jobs stay in
    sync; mismatched filters would emit jobs referencing non-existent outputs. -#}
{%- set testable_subpackages = [] -%}
{%- for pkg in subpackages -%}
{%- if pkg.type in ['go', 'rust'] or (pkg.type == 'node' and pkg.tests | default(true)) -%}
{%- set _ = testable_subpackages.append(pkg) -%}
{%- endif -%}
{%- endfor -%}
{#- Node subpackages that participate in pnpm install on CI: same `tests: false`
    opt-out as testable_subpackages, but scoped to node only. -#}
{%- set testable_node_pkgs = [] -%}
{%- for pkg in node_pkgs if pkg.tests | default(true) -%}
{%- set _ = testable_node_pkgs.append(pkg) -%}
{%- endfor -%}
{%- set go_hook_names = [] -%}
{%- for pkg in go_pkgs -%}
{%- set suffix = '-' ~ pkg.name if has_multiple_go_pkgs else '' -%}
{%- set _ = go_hook_names.append('go-fmt' ~ suffix) -%}
{%- set _ = go_hook_names.append('go-vet' ~ suffix) -%}
{%- endfor -%}
{%- if has_db %}
{%- set db_doc_paths = [] -%}
{%- for pkg in db_pkgs -%}
{%- if pkg.name == '.' -%}
{%- set schema_paths = db_schema_paths -%}
{%- elif pkg.db_schema_paths is defined -%}
{%- set schema_paths = pkg.db_schema_paths -%}
{%- elif pkg.type == 'node' -%}
{%- set schema_paths = [pkg.name ~ '/drizzle/**'] -%}
{%- elif pkg.type == 'rust' -%}
{%- set schema_paths = [pkg.name ~ '/migration/**'] -%}
{%- else -%}
{%- set schema_paths = [] -%}
{%- endif -%}
{%- for path in schema_paths -%}
{%- set _ = db_doc_paths.append(path) -%}
{%- endfor -%}
{%- endfor -%}
{%- set _ = db_doc_paths.extend(['**/.tbls.yml', 'scripts/db-*', 'compose*.yaml', '.mise.toml', '.github/workflows/test.yml']) -%}
{%- endif -%}
name: Test

on:
  push:
{%- if use_release_please %}
    branches-ignore:
      # Skip release-please branches (Release PRs) since they only update CHANGELOG and version
      - release-please--branches--*
{%- endif %}

permissions:
  contents: read
  id-token: write

jobs:
  test:
    runs-on: ubuntu-latest
{%- if has_rust %}
    env:
      SCCACHE_GHA_ENABLED: 'true'
      RUSTC_WRAPPER: 'sccache'
{%- endif %}

    steps:
      - uses: octo-sts/action@f603d3be9d8dd9871a265776e625a27b00effe05 # v1.1.1
        id: octo-sts
        with:
          scope: {% raw %}${{ github.repository }}{% endraw %}
          identity: {% raw %}${{ github.event.repository.name }}{% endraw %}
          domain: octo-sts.fohte.net

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 2

      - name: Check if current commit is auto-format by bot
        id: check-auto-format
        run: |
          commit_message=$(git log -1 --format=%s)
          commit_author=$(git log -1 --format=%an)
          echo "Current commit message: $commit_message"
          echo "Current commit author: $commit_author"

          # Skip if the current commit is an auto-format commit by a bot
          # to prevent infinite loop: auto-format push -> CI -> auto-format push -> ...
          if [ "$commit_message" = "style: auto-format" ] && [[ "$commit_author" == *"[bot]"* ]]; then
            echo "skip_commit=true" >> "$GITHUB_OUTPUT"
          else
            echo "skip_commit=false" >> "$GITHUB_OUTPUT"
          fi

{%- if has_rust %}

      # Run rustup before mise-action to prevent race condition.
      # Multiple cargo: tools in mise.toml trigger parallel rustup component downloads,
      # causing "could not rename downloaded file" errors.
      - run: rustup show

      # Run sccache-action before mise-action so that sccache binary is
      # available when mise installs cargo tools (RUSTC_WRAPPER=sccache).
      - name: Run sccache-cache
        uses: mozilla-actions/sccache-action@fc920bf0ec8de6ee65d409111f7ec508035751ba # v0.0.11
{%- endif %}

      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          version: 2026.9.14
{%- if type == 'node' %}

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles('pnpm-lock.yaml') }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}

      - run: pnpm install --frozen-lockfile

      - name: Check peer dependencies
        run: pnpm peers check
{%- elif type == 'rust' %}
{%- if has_node_pkg and not is_workspace and testable_node_pkgs %}
{#- prettier/commitlint are hosted by mise so the root has no package.json;
    only testable node subpackages install dependencies here.
    No fixture combines type: rust with a testable node subpackage (testable
    multi-package setups use monorepo mode instead), so this branch has no
    snapshot coverage. Render it manually via `copier copy --overwrite
    --defaults --vcs-ref HEAD --data-file <fixture>.yml . .` when editing. #}

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles({% endraw %}{% for pkg in testable_node_pkgs %}{% if not loop.first %}, {% endif %}'{{ pkg.name }}/pnpm-lock.yaml'{% endfor %}{% raw %}) }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}
{%- for pkg in testable_node_pkgs %}

      - name: Install pnpm dependencies ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm install --frozen-lockfile

      - name: Check peer dependencies ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm peers check
{%- endfor %}
{%- endif %}

      - run: cargo fetch
{%- elif subpackages %}
{%- if has_node %}
{%- if is_workspace %}
{#- Workspace mode: single root install (pnpm only) #}

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles('pnpm-lock.yaml') }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}

      - run: pnpm install --frozen-lockfile

      - name: Check peer dependencies
        run: pnpm peers check
{%- else %}
{#- Non-workspace mode: prettier/commitlint are hosted by mise (no root
    package.json), so only per-subpackage pnpm install runs here.
    Subpackages with `tests: false` bring their own pnpm setup, so their
    lockfile is intentionally excluded from the cache key and install step. #}
{%- if testable_node_pkgs %}

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles({% endraw %}{% for pkg in testable_node_pkgs %}{% if not loop.first %}, {% endif %}'{{ pkg.name }}/pnpm-lock.yaml'{% endfor %}{% raw %}) }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}
{%- for pkg in testable_node_pkgs %}

      - name: Install pnpm dependencies ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm install --frozen-lockfile

      - name: Check peer dependencies ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm peers check
{%- endfor %}
{%- endif %}
{%- endif %}
{%- endif %}
{%- if has_rust %}

{%- for pkg in rust_pkgs %}

      - name: Fetch cargo dependencies ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && cargo fetch
{%- endfor %}
{%- endif %}
{%- endif %}

{%- if has_db %}

      - name: Check for database documentation changes
        id: db-doc-changes
        uses: tj-actions/changed-files@9426d40962ed5378910ee2e21d5f8c6fcbf2dd96 # v47.0.6
        with:
          files: |
            {{ db_doc_paths | join('\n            ') }}

      - name: Generate database documentation
        if: steps.db-doc-changes.outputs.any_modified == 'true'
        run: mise run db:doc

      - name: Stage generated database documentation
        if: steps.db-doc-changes.outputs.any_modified == 'true'
        run: git add -- {% for pkg in db_pkgs %}{% if pkg.name == '.' %}docs/db{% else %}{{ pkg.name }}/docs/db{% endif %}{% if not loop.last %} {% endif %}{% endfor %}
{%- endif %}

      - name: Run lefthook
        id: lefthook
        continue-on-error: true
        env:
          # pinact's min-age check calls the GitHub API; without a token it hits
          # the 60 req/h unauthenticated limit shared per IP and fails on CI.
{%- if go_hook_names %}
          LEFTHOOK_EXCLUDE: {{ go_hook_names | join(',') }}
{%- endif %}
          GITHUB_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: lefthook run pre-commit --all-files

      # Formatters configured with `stage_fixed: true` run `git add` after formatting,
      # which stages the changes.
      # commit-action uses `git ls-files --modified` which only detects unstaged changes.
      # https://github.com/suzuki-shunsuke/commit-action/blob/87b297f0ce551411b43d1880f4fb3cbc60381055/action.yaml#L57
      # We need to unstage the changes so commit-action can detect them.
      - name: Unstage changes for commit-action
        run: git restore --staged .

      - name: Commit formatted files
        if: {% raw %}${{ !cancelled() && steps.check-auto-format.outputs.skip_commit != 'true' }}{% endraw %}
        uses: suzuki-shunsuke/commit-action@06e3b49d4706498d325d29bd85adc82ecf2f5d8f # v1.0.0
        with:
          commit_message: 'style: auto-format'
          workflow: deny
          github_token: {% raw %}${{ steps.octo-sts.outputs.token }}{% endraw %}

      - name: Fail if lefthook failed
        if: steps.lefthook.outcome == 'failure'
        run: exit 1
{%- if type == 'node' %}

{% include 'template/.github/workflows/_partials/node-unit-tests.yml.jinja' %}
{%- elif type == 'rust' %}

{% include 'template/.github/workflows/_partials/rust-unit-tests.yml.jinja' %}
{%- elif subpackages %}
{%- include 'template/.github/workflows/_partials/monorepo-unit-tests.yml.jinja' %}
{%- endif %}
{%- if type == 'node' or is_workspace or testable_node_pkgs %}

  knip:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: jdx/mise-action@c2a87611a18de5b3828c5652fe268e992400cb5c # v4.3.0
        with:
          version: 2026.9.14

      # corepack creates the pnpm executable inside mise's node install bin
      # directory; reshim so the mise shims dir (which is on PATH) picks it up.
      - run: |
          corepack enable
          mise reshim
{%- if type == 'node' or is_workspace %}

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles('pnpm-lock.yaml') }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}

      - run: pnpm install --frozen-lockfile

      - name: Run knip
        run: pnpm exec knip

      - name: Run knip in production mode
        run: pnpm exec knip --production
{%- else %}
{#- Non-workspace mode: each testable node subpackage is its own isolated
    pnpm project (own lockfile, own knip.json), so knip runs once per
    subpackage from its own directory, sharing one combined-key pnpm store
    cache (same pattern as the lefthook job above). No fixture combines
    type: rust with a testable node subpackage (testable multi-package setups
    use monorepo mode instead), so this branch has no snapshot coverage.
    Render it manually via `copier copy --overwrite --defaults --vcs-ref HEAD
    --data-file <fixture>.yml . .` when editing. #}

      - name: Get pnpm store directory
        id: pnpm-store
        run: echo "path=$(pnpm store path)" >> "$GITHUB_OUTPUT"

      - name: Cache pnpm store
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: |
            {% raw %}${{ steps.pnpm-store.outputs.path }}{% endraw %}
          key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles({% endraw %}{% for pkg in testable_node_pkgs %}{% if not loop.first %}, {% endif %}'{{ pkg.name }}/pnpm-lock.yaml'{% endfor %}{% raw %}) }}{% endraw %}
          restore-keys: {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}
{%- for pkg in testable_node_pkgs %}

      - name: Install pnpm dependencies ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm install --frozen-lockfile

      - name: Run knip ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm exec knip

      - name: Run knip in production mode ({{ pkg.name }})
        run: cd "{{ pkg.name }}" && pnpm exec knip --production
{%- endfor %}
{%- endif %}
{%- endif %}
