name: Docker publish

on:
  push:
    branches:
      - main
  workflow_dispatch:

permissions:
  contents: read
  packages: write

concurrency:
  group: {% raw %}docker-publish-${{ github.ref }}{% endraw %}
  cancel-in-progress: false

jobs:
{%- if has_web_app_pkg %}
  build:
    runs-on: ubuntu-latest

    strategy:
      matrix:
        include:
{%- for pkg in web_app_pkgs %}
          - component: {{ pkg.name }}
            context: {{ '.' if is_workspace else pkg.name }}
            dockerfile: {{ pkg.name }}/Dockerfile
{%- endfor %}

    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3.12.0

      - name: Log in to ghcr.io
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3.7.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@c299e40c65443455700f0fdfc63efafe5b349051 # v5.10.0
        with:
          images: {% raw %}ghcr.io/${{ github.repository }}/${{ matrix.component }}{% endraw %}
          tags: |
            type=sha
            type=raw,value=latest

      - name: Build and push
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6.19.2
        with:
          context: {% raw %}${{ matrix.context }}{% endraw %}
          file: {% raw %}${{ matrix.dockerfile }}{% endraw %}
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: {% raw %}type=gha,scope=${{ matrix.component }}{% endraw %}
          cache-to: {% raw %}type=gha,mode=max,scope=${{ matrix.component }}{% endraw %}
          # Disable provenance to avoid ghcr.io permission_denied errors on private packages
          # ref: https://github.com/docker/build-push-action/issues/981
          provenance: false
{%- else %}
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3.12.0

      - name: Log in to ghcr.io
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3.7.0
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@c299e40c65443455700f0fdfc63efafe5b349051 # v5.10.0
        with:
          images: {% raw %}ghcr.io/${{ github.repository }}{% endraw %}
          tags: |
            type=sha
            type=raw,value=latest

      - name: Build and push
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6.19.2
        with:
          context: .
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          # Disable provenance to avoid ghcr.io permission_denied errors on private packages
          # ref: https://github.com/docker/build-push-action/issues/981
          provenance: false
{%- endif %}
