{#- Slugify: lowercase, replace _ and / with -, remove @ -#}
{%- macro slug(name) %}{{ name | replace('_', '-') | replace('@', '') | replace('/', '-') | lower }}{% endmacro -%}
name: VRT approval

on:
  pull_request:
    types: [synchronize, labeled]

jobs:
{%- if root_vrt %}
  vrt-approval-root:
    permissions:
      contents: read
      pull-requests: write
      statuses: write
    uses: fohte/storybook-vrt-workflows/.github/workflows/vrt-approval.yml@e421864a67798d72cb0c12e48d5020ea0a8eee10 # v0.2.2
    with:
      r2-bucket: {{ root_vrt_slug }}-vrt
{%- endif %}
{%- for pkg in vrt_pkgs %}
  vrt-approval-{{ slug(pkg.name) }}:
    permissions:
      contents: read
      pull-requests: write
      statuses: write
    uses: fohte/storybook-vrt-workflows/.github/workflows/vrt-approval.yml@e421864a67798d72cb0c12e48d5020ea0a8eee10 # v0.2.2
    with:
      r2-bucket: {{ slug(project_name) }}-vrt
{%- endfor %}
