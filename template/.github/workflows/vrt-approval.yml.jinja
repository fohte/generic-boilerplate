{#- Slugify: lowercase, replace _ and / with -, remove @ -#}
{%- macro slug(name) %}{{ name | replace('_', '-') | replace('@', '') | replace('/', '-') | lower }}{% endmacro -%}
name: VRT approval

on:
  pull_request:
    types: [synchronize, labeled]

jobs:
{%- for pkg in vrt_pkgs %}
  vrt-approval-{{ slug(pkg.name) }}:
    permissions:
      contents: read
      pull-requests: write
      statuses: write
    uses: fohte/storybook-vrt-workflows/.github/workflows/vrt-approval.yml@b1745100ad0c07758b763db13f25e5a0f2d7beec # v0.1.5
    with:
      r2-bucket: {{ slug(project_name) }}-vrt
{%- endfor %}
