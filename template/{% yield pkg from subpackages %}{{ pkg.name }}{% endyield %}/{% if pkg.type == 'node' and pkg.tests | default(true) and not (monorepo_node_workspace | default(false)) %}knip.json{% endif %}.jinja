{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
{%- if pkg.spa | default(false) %}
  "entry": ["src/lib/**"],
{%- endif %}
{%- if pkg.vrt | default(false) %}
  "ignoreDependencies": [
    "@commitlint/cli",
    "reg-suit",
    "reg-publish-s3-plugin",
    "reg-simple-keygen-plugin"
  ]
{%- else %}
  "ignoreDependencies": ["@commitlint/cli"]
{%- endif %}
}
