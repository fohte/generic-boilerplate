{%- set has_storybook = pkg.storybook | default(false) -%}
{%- set has_tests = pkg.tests | default(true) -%}
{#- bootstrap.ts only emits when both web_app and tests are true (tests=false
    collapses the src/ segment). Keep the OTel/Sentry dependency block on the
    same gate so we never ship deps without the file that uses them. -#}
{%- set pkg_is_web_app = (pkg.web_app | default(false)) and (pkg.tests | default(true)) -%}
{#- error_tracking widens the OTel/Sentry dependency gate beyond web_app:
    bootstrap.ts also emits for error_tracking-only subpackages (see the
    bootstrap.ts filename template), so the deps must follow suit. Scripts
    and the tsup/tsx dev deps stay on pkg_is_web_app alone — those are
    HTTP-server-specific. -#}
{%- set pkg_has_error_tracking = ((pkg.web_app | default(false)) or (pkg.error_tracking | default(false))) and (pkg.tests | default(true)) -%}
{%- set has_scripts = has_tests or has_storybook -%}
{%- set has_dev_deps = (has_tests and not is_workspace) or has_storybook or pkg_is_web_app -%}
{
  "name": "{{ pkg.name }}",
  "private": true,
{%- if not is_workspace %}
  "packageManager": "pnpm@11.16.0",
{%- endif %}
  "type": "module"{{ "," if has_scripts else "" }}
{%- if has_tests %}
  "imports": {
    "#*": "./src/*.ts"
  },
{%- endif %}
{%- if has_scripts %}
  "scripts": {
{%- if has_tests and not is_workspace %}
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
{%- endif %}
{%- if has_tests %}
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"{{ "," if (pkg_is_web_app or has_storybook) else "" }}
{%- endif %}
{%- if pkg_is_web_app %}
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts"{{ "," if has_storybook else "" }}
{%- endif %}
{%- if has_storybook %}
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
{%- endif %}
  }{{ "," if has_dev_deps or has_tests else "" }}
{%- endif %}
{%- if has_tests %}
  "dependencies": {
{%- if pkg_has_error_tracking %}
    "@fohte/service-kit": "0.1.6",
    "@opentelemetry/api": "1.9.1",
{%- endif %}
    "neverthrow": "8.2.0"
  }{{ "," if has_dev_deps else "" }}
{%- endif %}
{%- if has_tests and not is_workspace %}
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@eslint/eslintrc": "3.3.6",
    "@fohte/eslint-config": "0.4.0",
    "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
{%- if has_storybook %}
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/react-vite": "10.5.5",
{%- endif %}
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "concurrently": "10.0.3",
    "eslint": "10.6.0",
{%- if has_storybook %}
    "eslint-plugin-storybook": "10.5.5",
{%- endif %}
    "prettier": "3.9.6",
{%- if has_storybook %}
    "storybook": "10.5.5",
{%- endif %}
{%- if pkg_is_web_app %}
    "tsup": "8.5.1",
    "tsx": "4.23.1",
{%- endif %}
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
{%- elif has_storybook or pkg_is_web_app %}
  "devDependencies": {
{%- if has_storybook %}
    "@storybook/addon-docs": "10.5.5",
    "@storybook/addon-themes": "10.5.5",
    "@storybook/react-vite": "10.5.5",
{%- endif %}
{%- if has_storybook and pkg_is_web_app %}
    "storybook": "10.5.5",
    "tsup": "8.5.1",
    "tsx": "4.23.1"
{%- elif has_storybook %}
    "storybook": "10.5.5"
{%- else %}
    "tsup": "8.5.1",
    "tsx": "4.23.1"
{%- endif %}
  }
{%- endif %}
}
