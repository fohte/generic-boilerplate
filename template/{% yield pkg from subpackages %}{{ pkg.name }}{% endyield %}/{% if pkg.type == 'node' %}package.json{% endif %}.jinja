{#- The vite.config.ts/index.html/components.json/.storybook/App.tsx/main.tsx/
    index.css/lib/utils.ts/vite-env.d.ts filename templates only emit when spa
    and tests are both true (tests=false collapses the src/ segment they
    reference). Keep this gate in sync with those. -#}
{%- set pkg_has_spa = (pkg.spa | default(false)) and (pkg.tests | default(true)) -%}
{%- set has_tests = pkg.tests | default(true) -%}
{#- bootstrap.ts only emits when both web_app and tests are true (tests=false
    collapses the src/ segment). Keep the OTel/Sentry dependency block on the
    same gate so we never ship deps without the file that uses them. -#}
{%- set pkg_is_web_app = (pkg.web_app | default(false)) and (pkg.tests | default(true)) -%}
{#- error_tracking widens the OTel/Sentry dependency gate beyond web_app:
    bootstrap.ts also emits for error_tracking-only subpackages (see the
    bootstrap.ts filename template), so the deps must follow suit. Scripts
    and the tsup/tsx dev deps stay on pkg_is_web_app alone — those are
    HTTP-server-specific. -#}
{%- set pkg_has_error_tracking = ((pkg.web_app | default(false)) or (pkg.error_tracking | default(false))) and (pkg.tests | default(true)) -%}
{#- vrt is meaningless without spa (it captures Storybook); keep this gate in
    sync with the vitest.screenshot.config.ts/.storybook/vitest.setup.screenshot.ts
    filename templates and vrt_pkgs in copier.yml. -#}
{%- set pkg_has_vrt = (pkg.vrt | default(false)) and pkg_has_spa -%}
{%- set has_scripts = has_tests or pkg_has_spa -%}
{%- set has_dev_deps = (has_tests and not is_workspace) or pkg_has_spa or pkg_is_web_app -%}
{
  "name": "{{ pkg.name }}",
  "private": true,
{%- if not is_workspace %}
  "packageManager": "pnpm@11.16.0",
{%- endif %}
  "type": "module"{{ "," if has_scripts else "" }}
{%- if has_tests %}
  "imports": {
{%- if pkg_has_spa %}
    "#*": {
      "types": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ],
      "default": "./src/*"
    }
{%- else %}
    "#*": "./src/*.ts"
{%- endif %}
  },
{%- endif %}
{%- if has_scripts %}
  "scripts": {
{%- if has_tests and not is_workspace %}
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
{%- endif %}
{%- if has_tests %}
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"{{ "," if (pkg_is_web_app or pkg_has_spa) else "" }}
{%- endif %}
{%- if pkg_is_web_app %}
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts"{{ "," if pkg_has_spa else "" }}
{%- elif pkg_has_spa %}
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
{%- endif %}
{%- if pkg_has_spa and pkg_is_web_app %}
    "dev:client": "vite",
    "build:client": "vite build",
    "preview:client": "vite preview",
{%- endif %}
{%- if pkg_has_spa %}
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"{{ "," if pkg_has_vrt else "" }}
{%- endif %}
{%- if pkg_has_vrt %}
    "storybook:screenshot": "vitest run --config vitest.screenshot.config.ts"
{%- endif %}
  }{{ "," if has_dev_deps or has_tests else "" }}
{%- endif %}
{%- if has_tests %}
  "dependencies": {
{%- if pkg_has_error_tracking %}
    "@fohte/service-kit": "0.1.11",
    "@opentelemetry/api": "1.9.1",
{%- endif %}
{%- if pkg_has_spa %}
    "clsx": "2.1.1",
{%- endif %}
    "neverthrow": "8.2.0"{{ "," if pkg_has_spa else "" }}
{%- if pkg_has_spa %}
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0"
{%- endif %}
  }{{ "," if has_dev_deps else "" }}
{%- endif %}
{%- if has_tests and not is_workspace %}
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@fohte/eslint-config": "0.4.3",
{%- if pkg_has_spa %}
    "@fohte/storybook-addon": "0.1.5",
{%- endif %}
    "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
{%- if pkg_has_spa %}
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
{%- endif %}
{%- if pkg_has_vrt %}
    "@storycap-testrun/browser": "2.1.1",
{%- endif %}
{%- if pkg_has_spa %}
    "@tailwindcss/vite": "4.3.3",
{%- endif %}
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
{%- if pkg_has_spa %}
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
{%- endif %}
    "concurrently": "10.0.4",
    "eslint": "10.6.0",
{%- if pkg_has_spa %}
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-tailwindcss": "4.2.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
{%- endif %}
    "prettier": "3.9.6",
{%- if pkg_has_vrt %}
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
{%- endif %}
{%- if pkg_has_spa %}
    "storybook": "10.4.6",
    "tailwindcss": "4.3.3",
{%- endif %}
{%- if pkg_is_web_app %}
    "tsup": "8.5.1",
    "tsx": "4.23.11",
{%- endif %}
{%- if pkg_has_spa %}
    "tw-animate-css": "1.4.0",
{%- endif %}
    "typescript": "6.0.3",
{%- if pkg_has_spa %}
    "vite": "8.2.1",
{%- endif %}
    "vitest": "4.1.10"
  }
{%- elif pkg_has_spa or pkg_is_web_app %}
  "devDependencies": {
{%- if pkg_has_spa %}
    "@fohte/storybook-addon": "0.1.5",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
{%- endif %}
{%- if pkg_has_vrt %}
    "@storycap-testrun/browser": "2.1.1",
{%- endif %}
{%- if pkg_has_spa %}
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
{%- endif %}
{%- if pkg_has_vrt %}
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
{%- endif %}
{%- if pkg_has_spa %}
    "storybook": "10.4.6",
    "tailwindcss": "4.3.3",
{%- endif %}
{%- if pkg_has_spa and pkg_is_web_app %}
    "tsup": "8.5.1",
    "tsx": "4.23.11",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.1"
{%- elif pkg_has_spa %}
    "tw-animate-css": "1.4.0",
    "vite": "8.2.1"
{%- else %}
    "tsup": "8.5.1",
    "tsx": "4.23.11"
{%- endif %}
  }
{%- endif %}
}
