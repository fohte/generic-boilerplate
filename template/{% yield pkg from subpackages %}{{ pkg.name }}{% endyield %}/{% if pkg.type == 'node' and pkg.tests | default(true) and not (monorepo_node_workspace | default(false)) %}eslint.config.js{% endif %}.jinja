{%- set pkg_has_spa = pkg.spa | default(false) -%}
import { config } from '@fohte/eslint-config'
{%- if pkg_has_spa %}
import storybook from 'eslint-plugin-storybook'
{%- endif %}

{% if pkg_has_spa -%}
export default config(
  {
    typescript: { typeChecked: true },
    errorHandling: {},
    tailwind: { cssConfigPath: 'src/index.css' },
  },
  ...storybook.configs['flat/recommended'],
  {
    // mockServiceWorker.js is generated by `msw init`; it must not be linted
    // or reformatted (see .prettierignore).
    ignores: ['public/mockServiceWorker.js'],
  },
  {
    // vite.config.ts/vitest.config.ts are loaded through Vite's own
    // esbuild-based config loader, which doesn't resolve the package.json
    // "imports" field, unlike the Rollup pipeline that bundles the app
    // itself. .storybook/vitest.setup.ts imports its sibling
    // .storybook/preview.ts by relative path because that file lives outside
    // src/, the only directory the "imports" field maps.
{%- set exempt_files = ['.storybook/vitest.setup.ts', 'vite.config.ts', 'vitest.config.ts'] %}
{%- if pkg.vrt | default(false) %}
{%- set exempt_files = exempt_files + ['.storybook/vitest.setup.screenshot.ts', 'vitest.screenshot.config.ts'] %}
{%- endif %}
{#- Mirror prettier's printWidth (80, the .prettierrc.yaml default) so this
    array renders single-line exactly when prettier would keep it single-line. -#}
{%- set files_content = "files: ['" ~ (exempt_files | join("', '")) ~ "']," %}
{%- if (4 + (files_content | length)) <= 80 %}
    {{ files_content }}
{%- else %}
    files: [
{%- for f in exempt_files %}
      '{{ f }}',
{%- endfor %}
    ],
{%- endif %}
    rules: { 'no-restricted-imports': 'off' },
  },
)
{%- else -%}
export default config({
  typescript: { typeChecked: true },
  errorHandling: {},
})
{%- endif %}
