{
  "name": "node",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts"
  },
  "dependencies": {
    "@fohte/service-kit": "0.1.18",
    "@opentelemetry/api": "1.10.0",
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@fohte/eslint-config": "0.5.3",
    "@ninoseki/eslint-plugin-neverthrow": "0.4.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "knip": "6.46.1",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
