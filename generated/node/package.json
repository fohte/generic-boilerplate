{
  "name": "node",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts"
  },
  "dependencies": {
    "@fohte/service-kit": "0.1.11",
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@fohte/eslint-config": "0.4.3",
    "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "concurrently": "10.0.4",
    "eslint": "10.6.0",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
