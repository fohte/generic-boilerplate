{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@commitlint/cli"],
      "ignoreBinaries": ["playwright"]
    },
    "frontend": {
      "entry": ["src/lib/**"],
      "ignoreDependencies": [
        "reg-suit",
        "reg-publish-s3-plugin",
        "reg-simple-keygen-plugin"
      ]
    }
  }
}
