#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

docker compose up -d --wait db

current_database_name=''

drop_database() {
  if [[ -z "$current_database_name" ]]; then
    return 0
  fi

  docker compose exec -T db dropdb \
    --username "monorepo" \
    --if-exists \
    --force \
    "$current_database_name"
  current_database_name=''
}

cleanup() {
  local exit_code=$?
  local cleanup_code=0
  trap - EXIT INT TERM

  drop_database || cleanup_code=$?

  if [[ "$exit_code" -ne 0 ]]; then
    exit "$exit_code"
  fi
  exit "$cleanup_code"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

run_db_doc() {
  local package="$1"
  local package_dir="$2"
  local migration_command
  migration_command="$(cat)"

  if [[ "$package" == "." ]]; then
    current_database_name="monorepo_doc_$$"
  else
    current_database_name="monorepo_doc_${package}_$$"
  fi

  docker compose exec -T db createdb \
    --username "monorepo" \
    "$current_database_name"

  local database_url
  database_url="$(scripts/db-url "$package" dev)"
  database_url="${database_url%/*}/$current_database_name"

  (
    cd "$package_dir"
    DATABASE_URL="$database_url" bash -c "$migration_command"
    TBLS_DSN="${database_url}?sslmode=disable" tbls doc --rm-dist -c .tbls.yml
    TBLS_DSN="${database_url}?sslmode=disable" tbls lint -c .tbls.yml
  )

  drop_database
}

run_db_doc 'frontend' 'frontend' << 'DB_MIGRATE'
pnpm run db:migrate
DB_MIGRATE

run_db_doc 'backend' 'backend' << 'DB_MIGRATE'
cargo run -q -p migration -- up
DB_MIGRATE
