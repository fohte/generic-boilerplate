{
  "name": "frontend",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "imports": {
    "#*": {
      "types": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "preview:client": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@fohte/service-kit": "0.1.11",
    "@opentelemetry/api": "1.9.1",
    "clsx": "2.1.1",
    "neverthrow": "8.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@eslint/eslintrc": "3.3.6",
    "@fohte/eslint-config": "0.4.1",
    "@fohte/storybook-addon": "0.1.2",
    "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "eslint-plugin-storybook": "10.4.6",
    "eslint-plugin-tailwindcss": "4.2.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.11",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
