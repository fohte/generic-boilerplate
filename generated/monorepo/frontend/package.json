{
  "name": "frontend",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "type": "module",
  "imports": {
    "#*": {
      "types": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ],
      "default": "./src/*"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "preview:client": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:screenshot": "vitest run --config vitest.screenshot.config.ts"
  },
  "dependencies": {
    "@fohte/service-kit": "0.1.18",
    "@opentelemetry/api": "1.10.0",
    "clsx": "2.1.1",
    "neverthrow": "8.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@fohte/eslint-config": "0.5.3",
    "@fohte/storybook-addon": "0.2.1",
    "@ninoseki/eslint-plugin-neverthrow": "0.4.0",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@storycap-testrun/browser": "3.1.3",
    "@tailwindcss/vite": "4.3.5",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "4.1.12",
    "@vitest/browser-playwright": "4.1.12",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-storybook": "10.6.7",
    "eslint-plugin-tailwindcss": "4.4.0",
    "knip": "6.46.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "playwright": "1.65.1",
    "prettier": "3.9.9",
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
