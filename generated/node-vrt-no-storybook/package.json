{
  "name": "my-site.test",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "neverthrow": "8.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.5.1",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.6",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
