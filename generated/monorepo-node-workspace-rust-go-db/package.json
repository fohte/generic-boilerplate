{
  "name": "workspace-db",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "packageManager": "pnpm@12.7.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@fohte/eslint-config": "0.5.3",
    "@ninoseki/eslint-plugin-neverthrow": "0.4.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "24.19.2",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "knip": "6.46.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
